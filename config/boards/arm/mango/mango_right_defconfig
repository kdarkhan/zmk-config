CONFIG_BOARD_MANGO_RIGHT=y
CONFIG_PINCTRL=y

# Deep Sleep after CONFIG_ZMK_IDLE_SLEEP_TIMEOUT (default 15 min) without input.
# Never while on USB power. The key that wakes the board is not sent.
CONFIG_ZMK_SLEEP=y
# 5 min instead of the default 15: on the right half the LEDs draw power while
# awake even when dark (see CONFIG_MANGO_IDLE_VCC_OFF).
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=300000

# RGB Underglow
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_WS2812_STRIP=y
# Keep EXT power on when the LEDs turn off: it is the nice!nano VCC output, which
# powers the display too (blank after RGB_TOG off/on until a restart).
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n
# Instead cut it after CONFIG_ZMK_IDLE_TIMEOUT (30 s) without input and redraw
# the display on the next keypress (idle_power.c). Deep sleep cuts it too.
# This also turns the LEDs off while idle, without ZMK's AUTO_OFF_IDLE, which
# saves the LEDs as off and so leaves them off after waking from deep sleep.
CONFIG_MANGO_IDLE_VCC_OFF=y
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=n
# Start off and let the saved state turn the LEDs on. With ON_START=y, ZMK v0.3
# draws a first frame before loading settings, so LEDs saved as off light up
# (frozen) after every power-up.
CONFIG_ZMK_RGB_UNDERGLOW_ON_START=n
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=3
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=10

# BLE Power
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Mouse keys (mouse layer, right joystick scroll)
CONFIG_ZMK_POINTING=y

# These nice!nano clones need the internal RC clock: with the default 32 kHz
# crystal setting the split link times out (reason 8) a few seconds after connecting.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# Displays
CONFIG_ZMK_DISPLAY=y
# Stop display updates (and the pet animation) after CONFIG_ZMK_IDLE_TIMEOUT
# without input; ZMK only enables this by default for OLEDs.
CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE=y

# Status screen: custom_status_screen.c with ZMK's built-in output and layer
# widgets, both halves' battery levels and Simone's pet. Don't enable a ZMK_WIDGET_*
# and the CUSTOM_WIDGET_* of the same kind together: they share names.
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=n
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y

CONFIG_ZMK_WIDGET_BATTERY_STATUS=n
CONFIG_ZMK_WIDGET_OUTPUT_STATUS=y
CONFIG_ZMK_WIDGET_LAYER_STATUS=y

CONFIG_CUSTOM_WIDGET_SPLIT_BATTERY_STATUS=y
CONFIG_CUSTOM_WIDGET_PET_STATUS=y
CONFIG_CUSTOM_WIDGET_BATTERY_STATUS=n
CONFIG_CUSTOM_WIDGET_OUTPUT_STATUS=n
CONFIG_CUSTOM_WIDGET_PROFILE_STATUS=n
CONFIG_CUSTOM_WIDGET_LAYER_STATUS=n

# Theme Mono
CONFIG_LV_USE_THEME_MONO=n

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
