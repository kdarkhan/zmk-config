config BOARD_ENABLE_DCDC
	bool "Enable DCDC mode"
	select SOC_DCDC_NRF52X
	default y
	depends on (BOARD_MANGO_LEFT || BOARD_MANGO_RIGHT)

config MANGO_IDLE_VCC_OFF
	bool "Cut VCC (LEDs and display) when idle, redraw the display on wake"
	depends on ZMK_RGB_UNDERGLOW && !ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
