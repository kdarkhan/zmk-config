CONFIG_BOARD_MANGO_LEFT=y
CONFIG_ZMK_SPLIT=y
CONFIG_PINCTRL=y

# Deep Sleep after CONFIG_ZMK_IDLE_SLEEP_TIMEOUT (default 15 min) without input.
# Never while on USB power. The key that wakes the board is not sent.
CONFIG_ZMK_SLEEP=y

# RGB Underglow
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_WS2812_STRIP=y
# Keep EXT power on when the LEDs turn off: the displays seem to be powered
# from it too (left display stayed blank after RGB_TOG off/on until a restart).
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n
# Turn the LEDs off after CONFIG_ZMK_IDLE_TIMEOUT (default 30 s) without input
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y
# Start off and let the saved state turn the LEDs on. With ON_START=y, ZMK v0.3
# draws a first frame before loading settings, so LEDs saved as off light up
# (frozen) after every power-up.
CONFIG_ZMK_RGB_UNDERGLOW_ON_START=n
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=3
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=10

# BLE Power
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# These nice!nano clones need the internal RC clock: with the default 32 kHz
# crystal setting the split link times out (reason 8) a few seconds after connecting.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# Displays
# Off: the left display gets noise pixels / lines after a while on any screen.
# Swapping panels showed the fault stays with the left board; reflow didn't fix it.
CONFIG_ZMK_DISPLAY=n

# Status screen: ZMK's built-in one. To use Simone's custom screen instead, set
# BUILT_IN=n / CUSTOM=y, turn off the ZMK_WIDGET_* lines and turn on the
# CUSTOM_WIDGET_* lines (see git history for the previous values).
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y
CONFIG_ZMK_WIDGET_BATTERY_STATUS=y
CONFIG_ZMK_WIDGET_PERIPHERAL_STATUS=y

CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=n
CONFIG_CUSTOM_WIDGET_BATTERY_STATUS=n
CONFIG_CUSTOM_WIDGET_PERIPHERAL_STATUS=n

# Theme Mono
CONFIG_LV_USE_THEME_MONO=n

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
